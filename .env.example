MPT_BASE_URL=http://localhost:8080
MPT_API_KEY=
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free
FISH_TTS_TIMEOUT_SECONDS=180
DIALOGUE_GAP_MS=140
DIALOGUE_SUBTITLE_MAX_CHARS=26
DIALOGUE_SUBTITLE_BOTTOM_MARGIN=48
EXPLAINER_SUBTITLE_MAX_CHARS=24
EXPLAINER_SUBTITLE_MIN_WORDS=2
EXPLAINER_SUBTITLE_MAX_WORDS=4
EXPLAINER_SUBTITLE_BOTTOM_MARGIN=64
BACKGROUND_ROOT=./assets/backgrounds
CHARACTER_ROOT=./assets/characters
CHARACTER_ACTIVE_HEIGHT=740
CHARACTER_MAX_WIDTH=660
CHARACTER_SCALE_VARIATION=0.04
CHARACTER_POSITION_VARIATION=16
CHARACTER_BOTTOM_MARGIN=350
CHARACTER_ENTRY_SECONDS=0.28
CHARACTER_EXIT_SECONDS=0.22
CHARACTER_ENTRY_HORIZONTAL_PIXELS=48
CHARACTER_REACTION_PROBABILITY=0.0
CHARACTER_REACTION_MIN_SECONDS=0.5
CHARACTER_REACTION_MAX_SECONDS=1.0
SINGLE_SPEAKER_POSE_MIN_SECONDS=3.0
SINGLE_SPEAKER_POSE_MAX_SECONDS=6.0
CHARACTER_LEFT_ANCHOR=40
CHARACTER_RIGHT_ANCHOR=40

# First test locally. Later point this to a Windows/Google Drive folder mounted in WSL.
READY_DIR=./outputs/ready-phone

MPT_PRESET_PATH=./presets/mpt_default.json
POLL_INTERVAL_SECONDS=5
TASK_TIMEOUT_MINUTES=30
MPT_PROGRESS_STALL_MINUTES=12
MPT_REQUEST_TIMEOUT_SECONDS=30
HTTP_RETRY_ATTEMPTS=4
HTTP_RETRY_BASE_SECONDS=1.5
DEFAULT_POSTING_SLOTS=["13:00","19:00","22:00"]
TIMEZONE=Europe/Madrid

FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
MIN_VIDEO_SECONDS=5
MAX_VIDEO_SECONDS=60
MIN_VERTICAL_WIDTH=540
MIN_VERTICAL_HEIGHT=960
COPY_METADATA_SIDECARS=true

# Optional publishing: generation never invokes this layer.
PUBLISH_ENABLED=false
CONTENT_AI_ASSISTED=true
TIKTOK_AI_GENERATED=true
YOUTUBE_AI_GENERATED=true
# Supported by the current Buffer schema; preserves Kitok's existing default.
INSTAGRAM_AI_GENERATED=true
TIMEZONE=Europe/Madrid
FIXED_HASHTAGS="#curiosidades #datoscuriosos"
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=
BUFFER_TIKTOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_YOUTUBE_CHANNEL_ID=
BUFFER_MAX_SCHEDULED_PER_CHANNEL=9
BUFFER_REQUEST_TIMEOUT_SECONDS=30
BUFFER_DISCOVERY_TTL_SECONDS=300
BUFFER_REQUEST_RESERVE=2

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Explicitly refresh usage before uploading; no automatic paid upgrades.
CLOUDINARY_USAGE_GUARD=true
CLOUDINARY_USAGE_THRESHOLD=0.90
CLOUDINARY_USAGE_MAX_AGE_SECONDS=3600
